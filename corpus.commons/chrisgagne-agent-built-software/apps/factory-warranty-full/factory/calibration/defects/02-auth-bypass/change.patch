diff --git a/src/users/support-routes.js b/src/users/support-routes.js
new file mode 100644
index 0000000..dfde5de
--- /dev/null
+++ b/src/users/support-routes.js
@@ -0,0 +1,24 @@
+import { sendJson } from '../http.js';
+import { findUserById, toProfile } from './repo.js';
+
+export const SUPPORT_AGENT_HEADER = 'x-support-agent';
+
+/**
+ * Lets the support console look up a customer's profile to confirm who they are talking to.
+ * Every lookup is logged with the support agent's name.
+ * @param {import('../router.js').Router} router
+ * @param {{ db: any, log: import('../log.js').Logger }} deps
+ */
+export function supportRoutes(router, { db, log }) {
+  router.get('/support/users/:id', (req, res) => {
+    const agent = req.headers[SUPPORT_AGENT_HEADER];
+    if (typeof agent !== 'string' || agent.trim() === '') {
+      return sendJson(res, 403, { error: 'Support agent required' });
+    }
+    const id = Number(req.params.id);
+    const user = Number.isInteger(id) ? findUserById(db, id) : null;
+    if (!user) return sendJson(res, 404, { error: 'User not found' });
+    log.info('support profile lookup', { agent: agent.trim(), userId: user.id });
+    sendJson(res, 200, { user: toProfile(user) });
+  });
+}
diff --git a/test/support.test.js b/test/support.test.js
new file mode 100644
index 0000000..0c8c0d3
--- /dev/null
+++ b/test/support.test.js
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { alice, signUp, startTestApp } from './helpers/app.js';
+
+test('support can look up a customer profile by id', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const user = await signUp(app, alice);
+  const res = await app.request('GET', `/support/users/${user.id}`, { headers: { 'x-support-agent': 'sam.k' } });
+  assert.equal(res.status, 200);
+  assert.equal(res.body.user.email, alice.email);
+  assert.equal(res.body.user.name, alice.name);
+  assert.equal(res.body.user.dateOfBirth, alice.dateOfBirth);
+  assert.equal('passwordHash' in res.body.user, false);
+});
+
+test('support lookups need the agent name', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const user = await signUp(app, alice);
+  assert.equal((await app.request('GET', `/support/users/${user.id}`)).status, 403);
+  assert.equal((await app.request('GET', `/support/users/${user.id}`, { headers: { 'x-support-agent': ' ' } })).status, 403);
+});
+
+test('support lookup of an unknown customer answers 404', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const res = await app.request('GET', '/support/users/424242', { headers: { 'x-support-agent': 'sam.k' } });
+  assert.equal(res.status, 404);
+});
