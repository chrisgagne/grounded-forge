diff --git a/test/birth-date-migration.test.js b/test/birth-date-migration.test.js
new file mode 100644
index 0000000..5a80395
--- /dev/null
+++ b/test/birth-date-migration.test.js
@@ -0,0 +1,38 @@
+import assert from 'node:assert/strict';
+import { copyFileSync, mkdtempSync, readdirSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { test } from 'node:test';
+import { openDatabase } from '../src/db/index.js';
+import { MIGRATIONS_DIR, migrateUp } from '../src/db/migrate.js';
+
+function migrationsUpTo(t, lastVersion) {
+  const dir = mkdtempSync(join(tmpdir(), 'migrations-'));
+  t.after(() => rmSync(dir, { recursive: true, force: true }));
+  for (const file of readdirSync(MIGRATIONS_DIR)) {
+    if (file.slice(0, 4) <= lastVersion) copyFileSync(join(MIGRATIONS_DIR, file), join(dir, file));
+  }
+  return dir;
+}
+
+test('converts old DD/MM/YYYY dates of birth to ISO dates', (t) => {
+  const db = openDatabase();
+  migrateUp(db, { dir: migrationsUpTo(t, '0004') });
+  const insert = db.prepare(
+    'INSERT INTO users (email, password_hash, name, date_of_birth, created_at) VALUES (?, ?, ?, ?, ?)',
+  );
+  insert.run('old@example.com', 'x', 'Old Form', '12/04/1990', 0);
+  insert.run('new@example.com', 'x', 'New Form', '1985-11-30', 0);
+  insert.run('none@example.com', 'x', 'No Date', null, 0);
+
+  migrateUp(db);
+
+  const dates = Object.fromEntries(
+    db.prepare('SELECT email, birth_date FROM users').all().map((row) => [row.email, row.birth_date]),
+  );
+  assert.deepEqual(dates, {
+    'old@example.com': '1990-04-12',
+    'new@example.com': '1985-11-30',
+    'none@example.com': null,
+  });
+});
