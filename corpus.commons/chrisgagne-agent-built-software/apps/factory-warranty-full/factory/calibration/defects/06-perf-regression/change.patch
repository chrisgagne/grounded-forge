diff --git a/test/notes-stats.test.js b/test/notes-stats.test.js
new file mode 100644
index 0000000..4574d1f
--- /dev/null
+++ b/test/notes-stats.test.js
@@ -0,0 +1,42 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { addNote, alice, bob, signUpAndLogIn, startTestApp } from './helpers/app.js';
+
+test('the notes list reports the total and the most-used tags', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  const bobCookie = await signUpAndLogIn(app, bob);
+  await addNote(app, cookie, { title: 'a', tags: ['work', 'q3'] });
+  await addNote(app, cookie, { title: 'b', tags: ['work'] });
+  await addNote(app, cookie, { title: 'c', tags: ['home'] });
+  await addNote(app, bobCookie, { title: 'd', tags: ['home', 'garden'] });
+
+  const res = await app.request('GET', '/notes?limit=1', { cookie });
+  assert.equal(res.status, 200);
+  assert.equal(res.body.notes.length, 1);
+  assert.equal(res.body.total, 3);
+  assert.deepEqual(res.body.topTags, [
+    { name: 'work', count: 2 },
+    { name: 'home', count: 1 },
+    { name: 'q3', count: 1 },
+  ]);
+});
+
+test('the total counts only notes with the selected tag', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  await addNote(app, cookie, { title: 'a', tags: ['work'] });
+  await addNote(app, cookie, { title: 'b', tags: ['home'] });
+  const res = await app.request('GET', '/notes?tag=work', { cookie });
+  assert.equal(res.body.total, 1);
+});
+
+test('a new account has no notes and no tags', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  const res = await app.request('GET', '/notes', { cookie });
+  assert.deepEqual({ total: res.body.total, topTags: res.body.topTags }, { total: 0, topTags: [] });
+});
