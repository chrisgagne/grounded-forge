+/**
+ * How many of the user's notes match `tag` (all notes when there is no tag), and their most-used tags.
+ * @param {any} db
+ * @param {number} userId
+ * @param {string | null} tag
+ */
+function noteStats(db, userId, tag) {
+  /** @type {Map<string, number>} */
+  const counts = new Map();
+  let total = 0;
+  for (const id of listNoteIds(db, userId)) {
+    const tags = getNoteTags(db, id);
+    if (!tag || tags.includes(tag)) total += 1;
+    for (const name of tags) counts.set(name, (counts.get(name) ?? 0) + 1);
+  }
+  const topTags = [...counts]
+    .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
+    .slice(0, TOP_TAG_COUNT)
+    .map(([name, count]) => ({ name, count }));
+  return { total, topTags };
+}
