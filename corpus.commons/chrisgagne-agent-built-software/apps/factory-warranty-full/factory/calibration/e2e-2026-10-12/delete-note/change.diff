new file mode 100644
index 0000000..ed3a9fc
--- /dev/null
+++ b/rollback.md
@@ -0,0 +1,24 @@
+# Rollback: delete a note
+
+This change adds `DELETE /notes/:id`. It has no migration and changes no schema.
+
+## Undo the code
+
+Revert the commit that adds the route (`git revert <commit>`) and redeploy. Once that's done, nobody can delete notes. Nothing in the database needs to change.
+
+## Restore deleted notes
+
+A delete is a hard delete: the `notes` row and its `note_tags` rows are removed. Reverting the code does not bring them back. The only way to recover a deleted note is from a database backup taken before the delete:
+
+```sql
+ATTACH DATABASE '/path/to/backup.db' AS backup;
+BEGIN;
+INSERT INTO notes SELECT * FROM backup.notes WHERE id = :note_id AND user_id = :user_id;
+INSERT INTO note_tags SELECT * FROM backup.note_tags WHERE note_id = :note_id;
+COMMIT;
+DETACH DATABASE backup;
+```
+
+The rehearsal makes a backup of a throwaway database, deletes a note, restores the note with the steps above, and checks that the note and its tags match what was there before.
+
+rehearse: node --disable-warning=ExperimentalWarning scripts/rehearse-rollback.js
diff --git a/scripts/rehearse-rollback.js b/scripts/rehearse-rollback.js
new file mode 100644
index 0000000..12f8d80
--- /dev/null
+++ b/scripts/rehearse-rollback.js
@@ -0,0 +1,40 @@
+// Rehearses rollback.md against a throwaway database: back up, delete a note, restore it from the backup.
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { openDatabase } from '../src/db/index.js';
+import { migrateUp } from '../src/db/migrate.js';
+import { createNote, deleteNote, getNote } from '../src/notes/repo.js';
+
+const dir = mkdtempSync(join(tmpdir(), 'notes-rollback-'));
+try {
+  const db = openDatabase(join(dir, 'notes.db'));
+  migrateUp(db);
+  const userId = Number(
+    db
+      .prepare('INSERT INTO users (email, password_hash, name, created_at) VALUES (?, ?, ?, ?)')
+      .run('rehearsal@example.com', 'not-a-real-hash', 'Rehearsal', Date.now()).lastInsertRowid,
+  );
+  const note = createNote(db, userId, { title: 'keep', body: 'restore me', tags: ['a', 'b'], now: Date.now() });
+  assert.ok(note);
+
+  const backup = join(dir, 'backup.db');
+  db.prepare('VACUUM INTO ?').run(backup);
+  assert.equal(deleteNote(db, userId, note.id), true);
+  assert.equal(getNote(db, userId, note.id), null);
+
+  // The restore step from rollback.md.
+  db.prepare('ATTACH DATABASE ? AS backup').run(backup);
+  db.exec('BEGIN');
+  db.prepare('INSERT INTO notes SELECT * FROM backup.notes WHERE id = ? AND user_id = ?').run(note.id, userId);
+  db.prepare('INSERT INTO note_tags SELECT * FROM backup.note_tags WHERE note_id = ?').run(note.id);
+  db.exec('COMMIT');
+  db.exec('DETACH DATABASE backup');
+
+  assert.deepEqual(getNote(db, userId, note.id), note);
+  db.close();
+  console.log('rollback rehearsal ok');
+} finally {
+  rmSync(dir, { recursive: true, force: true });
+}
diff --git a/src/notes/repo.js b/src/notes/repo.js
index 6358961..7169bd2 100644
--- a/src/notes/repo.js
+++ b/src/notes/repo.js
@@ -64,3 +64,18 @@ export function createNote(db, userId, { title, body, tags, now }) {
     return getNote(db, userId, noteId);
   });
 }
+
+/**
+ * Deletes one of the user's notes and its tags.
+ * @returns {boolean} whether a note was deleted
+ */
+export function deleteNote(db, userId, noteId) {
+  return transaction(db, () => {
+    db.prepare('DELETE FROM note_tags WHERE note_id IN (SELECT id FROM notes WHERE id = ? AND user_id = ?)').run(
+      noteId,
+      userId,
+    );
+    const result = db.prepare('DELETE FROM notes WHERE id = ? AND user_id = ?').run(noteId, userId);
+    return Number(result.changes) > 0;
+  });
+}
