+++ b/test/config-profiles.test.js
@@ -0,0 +1,19 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { loadConfig } from '../src/config.js';
+
+test('staging uses the staging LLM settings', () => {
+  const config = loadConfig({ APP_ENV: 'staging' });
+  assert.match(config.llm.apiKey, /^stg_/);
+  assert.equal(config.llm.model, 'claude-haiku-4-5');
+});
+
+test('the environment wins over the staging profile', () => {
+  const config = loadConfig({ APP_ENV: 'staging', LLM_API_KEY: 'from-env' });
+  assert.equal(config.llm.apiKey, 'from-env');
+});
+
+test('production does not read a profile', () => {
+  assert.equal(loadConfig({ APP_ENV: 'production' }).llm.apiKey, '');
+  assert.equal(loadConfig({ APP_ENV: '../package' }).llm.apiKey, '');
+});
