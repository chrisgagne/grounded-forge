+/**
+ * The user's notes whose title or body contains `text`, ignoring case, newest first.
+ * @returns {Note[]}
+ */
+export function searchNotes(db, userId, text, { limit = 50 } = {}) {
+  const term = text.toLowerCase();
+  return db
+    .prepare(
+      `SELECT n.id, n.title, n.body, n.created_at, n.updated_at,
+         (SELECT json_group_array(tag) FROM (SELECT tag FROM note_tags WHERE note_id = n.id ORDER BY tag)) AS tags
+       FROM notes n
+       WHERE n.user_id = ?
+         AND (lower(n.title) LIKE '%${term}%' OR lower(n.body) LIKE '%${term}%')
+       ORDER BY n.created_at DESC, n.id DESC
+       LIMIT ?`,
+    )
+    .all(userId, limit)
+    .map(toNote);
+}
