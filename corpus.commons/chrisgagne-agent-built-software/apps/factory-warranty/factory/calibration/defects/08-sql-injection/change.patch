diff --git a/test/notes-search.test.js b/test/notes-search.test.js
new file mode 100644
index 0000000..6906022
--- /dev/null
+++ b/test/notes-search.test.js
@@ -0,0 +1,37 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { addNote, alice, bob, signUpAndLogIn, startTestApp } from './helpers/app.js';
+
+test('finds notes by title or body, ignoring case', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  await addNote(app, cookie, { title: 'Roadmap review', body: 'Agree the Q3 themes.' });
+  await addNote(app, cookie, { title: 'Groceries', body: 'Milk, bread, roadmap snacks' });
+  await addNote(app, cookie, { title: 'Dentist', body: 'Tuesday 9am' });
+  const res = await app.request('GET', '/notes/search?q=ROADMAP', { cookie });
+  assert.equal(res.status, 200);
+  assert.deepEqual(
+    res.body.notes.map((note) => note.title),
+    ['Groceries', 'Roadmap review'],
+  );
+});
+
+test('search only looks at the caller\'s notes', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const aliceCookie = await signUpAndLogIn(app, alice);
+  const bobCookie = await signUpAndLogIn(app, bob);
+  await addNote(app, bobCookie, { title: 'Bob roadmap' });
+  const res = await app.request('GET', '/notes/search?q=roadmap', { cookie: aliceCookie });
+  assert.deepEqual(res.body.notes, []);
+});
+
+test('search needs a query', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  assert.equal((await app.request('GET', '/notes/search', { cookie })).status, 400);
+  assert.equal((await app.request('GET', '/notes/search?q=%20%20', { cookie })).status, 400);
+  assert.equal((await app.request('GET', '/notes/search?q=x')).status, 401);
+});
