diff --git a/test/note-ids.test.js b/test/note-ids.test.js
new file mode 100644
index 0000000..e972d7e
--- /dev/null
+++ b/test/note-ids.test.js
@@ -0,0 +1,59 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { openDatabase } from '../src/db/index.js';
+import { migrateDown, migrateUp } from '../src/db/migrate.js';
+import { createNote, deleteNote, getNote, listNotes } from '../src/notes/repo.js';
+
+function seededDb() {
+  const db = openDatabase();
+  migrateUp(db);
+  const userId = Number(
+    db
+      .prepare('INSERT INTO users (email, password_hash, name, created_at) VALUES (?, ?, ?, ?)')
+      .run('ids@example.com', 'not-a-real-hash', 'Ids', 1).lastInsertRowid,
+  );
+  return { db, userId };
+}
+
+const tagRows = (db) =>
+  db
+    .prepare('SELECT note_id, tag FROM note_tags ORDER BY note_id, tag')
+    .all()
+    .map((row) => ({ note_id: Number(row.note_id), tag: String(row.tag) }));
+
+test("a new note never takes a deleted note's id", () => {
+  const { db, userId } = seededDb();
+  createNote(db, userId, { title: 'older', body: '', tags: [], now: 1 });
+  const newest = createNote(db, userId, { title: 'newest', body: '', tags: ['x'], now: 2 });
+  assert.equal(deleteNote(db, userId, newest.id), true);
+  const next = createNote(db, userId, { title: 'next', body: '', tags: [], now: 3 });
+  assert.ok(next.id > newest.id);
+});
+
+test('repeating a delete of a stale id does not remove a newer note', () => {
+  const { db, userId } = seededDb();
+  const stale = createNote(db, userId, { title: 'stale', body: '', tags: [], now: 1 });
+  assert.equal(deleteNote(db, userId, stale.id), true);
+  const fresh = createNote(db, userId, { title: 'fresh', body: '', tags: ['keep'], now: 2 });
+  assert.equal(deleteNote(db, userId, stale.id), false);
+  assert.deepEqual(getNote(db, userId, fresh.id), fresh);
+});
+
+test('the id migration keeps every note and tag, up and down', () => {
+  const { db, userId } = seededDb();
+  migrateDown(db);
+  const a = createNote(db, userId, { title: 'a', body: 'alpha', tags: ['one', 'two'], now: 1 });
+  const b = createNote(db, userId, { title: 'b', body: 'beta', tags: ['two'], now: 2 });
+  const before = { notes: listNotes(db, userId), tags: tagRows(db) };
+  assert.deepEqual(before.notes, [b, a]);
+
+  migrateUp(db);
+  assert.deepEqual({ notes: listNotes(db, userId), tags: tagRows(db) }, before);
+  assert.deepEqual(db.prepare('PRAGMA foreign_key_check').all(), []);
+
+  migrateDown(db);
+  assert.deepEqual({ notes: listNotes(db, userId), tags: tagRows(db) }, before);
+  assert.deepEqual(db.prepare('PRAGMA foreign_key_check').all(), []);
+  assert.equal(deleteNote(db, userId, a.id), true);
+  assert.deepEqual(tagRows(db), [{ note_id: b.id, tag: 'two' }]);
+});
