+
+test('rolling back the phone number migration keeps existing accounts', async (t) => {
+  const db = openDatabase();
+  t.after(() => db.close());
+  migrateUp(db);
+
+  const first = await startTestAppOn(db);
+  const aliceSignup = await first.request('POST', '/signup', { body: { ...alice, phoneNumber: '+64211234567' } });
+  assert.equal(aliceSignup.status, 201);
+  const bobSignup = await first.request('POST', '/signup', { body: bob });
+  assert.equal(bobSignup.status, 201);
+  await first.close();
+
+  const accounts = () =>
+    db.prepare('SELECT id, email, password_hash, name, date_of_birth, created_at FROM users ORDER BY id').all();
+  const before = accounts();
+  assert.equal(before.length, 2);
+
+  const reverted = migrateDown(db);
+  assert.equal(reverted.length, 1);
+  const revertedVersion = reverted[0].slice(0, 4);
+  assert.ok(
+    !BEFORE_PHONE_NUMBERS.includes(revertedVersion),
+    `expected the latest migration to be the phone number one, but rolled back ${reverted[0]}`,
+  );
+  assert.deepEqual(accounts(), before);
+  assert.deepEqual(appliedVersions(db), BEFORE_PHONE_NUMBERS);
+
+  assert.deepEqual(migrateUp(db), reverted);
+  assert.deepEqual(accounts(), before);
+
+  const app = await startTestAppOn(db);
+  t.after(app.close);
+  for (const [user, signup] of [
+    [alice, aliceSignup.body.user],
+    [bob, bobSignup.body.user],
+  ]) {
+    const { login, me } = await loginProfile(app, user);
+    for (const profile of [login, me]) {
+      assert.equal(profile.id, signup.id);
+      assert.equal(profile.email, user.email);
+      assert.equal(profile.name, user.name);
+      assert.equal(profile.dateOfBirth, user.dateOfBirth);
+      assert.equal(profile.createdAt, signup.createdAt);
+      assert.ok('phoneNumber' in profile, 'expected the profile to include phoneNumber');
+      assert.equal(profile.phoneNumber, null);
+    }
+  }
+});
