diff --git a/rollback.md b/rollback.md
new file mode 100644
index 0000000..17f47e7
--- /dev/null
+++ b/rollback.md
@@ -0,0 +1,32 @@
+# Rollback: optional phone number on the profile
+
+The change adds migration `0005_add_user_phone_number`, which adds a nullable `phone_number` column to `users`. Existing rows get `NULL`; no other column or row is touched.
+
+## How to undo
+
+1. Deploy the previous version of the app (the one without `phoneNumber`). It reads and writes users by named columns, so it runs fine against a schema that still has `phone_number`; this step alone stops the feature.
+2. If the column must go too, revert the migration:
+
+   ```
+   DATABASE_PATH=<path to the database> npm run migrate -- down 1
+   ```
+
+   This runs `migrations/0005_add_user_phone_number.down.sql`, which removes the `phone_number` column from `users`, and removes `0005` from `schema_migrations`, all in one transaction. Accounts, sessions, notes and tags, and every other profile field, are kept.
+
+## What is lost
+
+Rolling back the migration deletes every stored phone number. They cannot be recovered from the database afterwards. If they may be needed again, export them first:
+
+```
+sqlite3 <path to the database> "SELECT id, phone_number FROM users WHERE phone_number IS NOT NULL" > phone-numbers.csv
+```
+
+That file is personal data: keep it access-controlled and delete it when it is no longer needed.
+
+Running `npm run migrate` again re-adds the column with every account at `phoneNumber: null`.
+
+## Rehearsal
+
+The rehearsal runs the real migrations against a scratch SQLite file: it migrates up, adds two accounts (one with a phone number), rolls back one step, checks that `0005` was the step reverted, that the column is gone and that the accounts are byte-for-byte unchanged, then migrates up again and checks every account has no phone number.
+
+rehearse: node --disable-warning=ExperimentalWarning scripts/rehearse-rollback.js
diff --git a/scripts/rehearse-rollback.js b/scripts/rehearse-rollback.js
new file mode 100644
index 0000000..4763f0a
--- /dev/null
+++ b/scripts/rehearse-rollback.js
@@ -0,0 +1,38 @@
+// Rehearses rolling back the phone number migration (0005) on a scratch database file:
+// migrate up, add accounts, roll back one step, check the accounts are intact, migrate up again.
+// Exits 0 when the rollback works and non-zero otherwise.
+import assert from 'node:assert/strict';
+import { mkdtempSync, rmSync } from 'node:fs';
+import { tmpdir } from 'node:os';
+import { join } from 'node:path';
+import { openDatabase } from '../src/db/index.js';
+import { appliedVersions, migrateDown, migrateUp } from '../src/db/migrate.js';
+
+const dir = mkdtempSync(join(tmpdir(), 'rehearse-rollback-'));
+const db = openDatabase(join(dir, 'notes.db'));
+try {
+  migrateUp(db);
+  const insert = db.prepare(
+    'INSERT INTO users (email, password_hash, name, date_of_birth, phone_number, created_at) VALUES (?, ?, ?, ?, ?, ?)',
+  );
+  insert.run('alice@example.com', 'hash-a', 'Alice', '1990-04-12', '+64211234567', 1);
+  insert.run('bob@example.com', 'hash-b', 'Bob', null, null, 2);
+  const accounts = () =>
+    db.prepare('SELECT id, email, password_hash, name, date_of_birth, created_at FROM users ORDER BY id').all();
+  const columns = () => db.prepare('SELECT name FROM pragma_table_info(?)').all('users').map((row) => row.name);
+  const before = accounts();
+
+  assert.deepEqual(migrateDown(db), ['0005_add_user_phone_number']);
+  assert.deepEqual(appliedVersions(db), ['0001', '0002', '0003', '0004']);
+  assert.ok(!columns().includes('phone_number'), 'phone_number column should be gone');
+  assert.deepEqual(accounts(), before);
+
+  assert.deepEqual(migrateUp(db), ['0005_add_user_phone_number']);
+  assert.deepEqual(accounts(), before);
+  const phones = db.prepare('SELECT phone_number FROM users').all().map((row) => row.phone_number);
+  assert.deepEqual(phones, [null, null]);
+  console.log('rollback rehearsal passed');
+} finally {
+  db.close();
+  rmSync(dir, { recursive: true, force: true });
+}
