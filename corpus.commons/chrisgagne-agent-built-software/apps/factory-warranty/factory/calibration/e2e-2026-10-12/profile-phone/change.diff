+/**
+ * Phone numbers are optional and must already be in E.164 form (`+` and 2 to 15 digits). Nothing is normalised.
+ * @param {unknown} value
+ * @returns {string | null}
+ */
+export function validatePhoneNumber(value) {
+  if (value === undefined || value === null || value === '') return null;
