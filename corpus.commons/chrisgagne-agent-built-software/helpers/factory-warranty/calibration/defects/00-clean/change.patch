@@ -64,3 +64,31 @@ export function createNote(db, userId, { title, body, tags, now }) {
     return getNote(db, userId, noteId);
   });
 }
+
+/**
+ * Changes the given fields of one of the user's notes. Tags, when given, replace the note's tags.
+ * Returns null when the user has no note with that id.
+ * @param {any} db
+ * @param {number} userId
+ * @param {number} noteId
+ * @param {{ title?: string, body?: string, tags?: string[], now: number }} changes
+ */
+export function updateNote(db, userId, noteId, { title, body, tags, now }) {
+  return transaction(db, () => {
+    const current = getNote(db, userId, noteId);
+    if (!current) return null;
+    db.prepare('UPDATE notes SET title = ?, body = ?, updated_at = ? WHERE id = ? AND user_id = ?').run(
+      title ?? current.title,
+      body ?? current.body,
+      now,
+      noteId,
+      userId,
+    );
+    if (tags) {
+      db.prepare('DELETE FROM note_tags WHERE note_id = ?').run(noteId);
+      const insertTag = db.prepare('INSERT INTO note_tags (note_id, tag) VALUES (?, ?)');
+      for (const tag of tags) insertTag.run(noteId, tag);
+    }
+    return getNote(db, userId, noteId);
+  });
+}
