diff --git a/test/notes-edit.test.js b/test/notes-edit.test.js
new file mode 100644
index 0000000..0da5380
--- /dev/null
+++ b/test/notes-edit.test.js
@@ -0,0 +1,77 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { DAY, addNote, alice, bob, signUpAndLogIn, startTestApp } from './helpers/app.js';
+
+test('edits the title and body of a note', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  const note = await addNote(app, cookie, { title: 'Quartely plan', body: 'Ship export.', tags: ['work'] });
+  const res = await app.request('PATCH', `/notes/${note.id}`, { cookie, body: { title: 'Quarterly plan', body: 'Ship export in May.' } });
+  assert.equal(res.status, 200);
+  assert.equal(res.body.note.title, 'Quarterly plan');
+  assert.equal(res.body.note.body, 'Ship export in May.');
+  assert.deepEqual(res.body.note.tags, ['work']);
+  const again = await app.request('GET', `/notes/${note.id}`, { cookie });
+  assert.equal(again.body.note.title, 'Quarterly plan');
+});
+
+test('replaces the tags of a note and leaves other fields alone', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  const note = await addNote(app, cookie, { title: 'Retro', body: 'Went well.', tags: ['work', 'team'] });
+  const res = await app.request('PATCH', `/notes/${note.id}`, { cookie, body: { tags: ['team', 'q3', 'q3'] } });
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body.note.tags, ['q3', 'team']);
+  assert.equal(res.body.note.title, 'Retro');
+  assert.equal(res.body.note.body, 'Went well.');
+  const tagged = await app.request('GET', '/notes?tag=work', { cookie });
+  assert.deepEqual(tagged.body.notes, []);
+});
+
+test('an edit moves updatedAt and keeps createdAt', async (t) => {
+  let clock = Date.parse('2026-04-01T08:00:00Z');
+  const app = await startTestApp({ now: () => clock });
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  const note = await addNote(app, cookie, { title: 'Draft' });
+  clock += DAY;
+  const res = await app.request('PATCH', `/notes/${note.id}`, { cookie, body: { body: 'Now with text.' } });
+  assert.equal(res.body.note.createdAt, '2026-04-01T08:00:00.000Z');
+  assert.equal(res.body.note.updatedAt, '2026-04-02T08:00:00.000Z');
+});
+
+test('validates edits like new notes', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  const note = await addNote(app, cookie, { title: 'Keep me' });
+  for (const body of [{}, { title: '   ' }, { body: 42 }, { tags: ['Not A Tag'] }, { tags: 'work' }]) {
+    const res = await app.request('PATCH', `/notes/${note.id}`, { cookie, body });
+    assert.equal(res.status, 400, JSON.stringify(body));
+  }
+  assert.equal((await app.request('GET', `/notes/${note.id}`, { cookie })).body.note.title, 'Keep me');
+});
+
+test('cannot edit someone else\'s note', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const aliceCookie = await signUpAndLogIn(app, alice);
+  const bobCookie = await signUpAndLogIn(app, bob);
+  const note = await addNote(app, aliceCookie, { title: 'Mine', tags: ['private'] });
+  const res = await app.request('PATCH', `/notes/${note.id}`, { cookie: bobCookie, body: { title: 'Yours now', tags: [] } });
+  assert.equal(res.status, 404);
+  const own = await app.request('GET', `/notes/${note.id}`, { cookie: aliceCookie });
+  assert.equal(own.body.note.title, 'Mine');
+  assert.deepEqual(own.body.note.tags, ['private']);
+});
+
+test('editing a note that does not exist answers 404', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  assert.equal((await app.request('PATCH', '/notes/9999', { cookie, body: { title: 'x' } })).status, 404);
+  assert.equal((await app.request('PATCH', '/notes/abc', { cookie, body: { title: 'x' } })).status, 404);
+  assert.equal((await app.request('PATCH', '/notes/1', { body: { title: 'x' } })).status, 401);
+});
