diff --git a/test/assistant-request.test.js b/test/assistant-request.test.js
new file mode 100644
index 0000000..bb85055
--- /dev/null
+++ b/test/assistant-request.test.js
@@ -0,0 +1,51 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { addNote, alice, signUpAndLogIn, startTestApp } from './helpers/app.js';
+import { fakeMailer, scriptedLlm, text, toolUse } from './helpers/fakes.js';
+
+test('answers a free-text request about the notes', async (t) => {
+  const llm = scriptedLlm(text('You promised Sam the Q3 deck by Friday.'));
+  const app = await startTestApp({ llm });
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  await addNote(app, cookie, { title: '1:1 with Sam', body: 'Send Sam the Q3 deck by Friday.' });
+
+  const res = await app.request('POST', '/notes/summary', { cookie, body: { request: 'What did I promise Sam?' } });
+  assert.equal(res.status, 200);
+  assert.equal(res.body.summary, 'You promised Sam the Q3 deck by Friday.');
+  assert.equal(llm.calls[0].messages[0].content, 'What did I promise Sam?');
+  assert.match(llm.calls[0].system, /Send Sam the Q3 deck/);
+});
+
+test('emails the person the user names in the request', async (t) => {
+  const llm = scriptedLlm(
+    toolUse('send_email', { to: 'dana@acme.com', subject: 'Standup', body: 'Yesterday: export. Today: tests.' }),
+    text('Sent your standup to dana@acme.com.'),
+  );
+  const mailer = fakeMailer();
+  const app = await startTestApp({ llm, mailer });
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  await addNote(app, cookie, { title: 'Standup', body: 'Yesterday: export. Today: tests.', tags: ['standup'] });
+
+  const res = await app.request('POST', '/notes/summary', {
+    cookie,
+    body: { request: 'Turn my standup notes into a status update and email it to dana@acme.com', tag: 'standup' },
+  });
+  assert.equal(res.status, 200);
+  assert.deepEqual(res.body.email, { to: 'dana@acme.com', status: 'sent' });
+  assert.equal(mailer.sent[0].to, 'dana@acme.com');
+});
+
+test('refuses to email something that is not an address', async (t) => {
+  const llm = scriptedLlm(toolUse('send_email', { to: 'dana', subject: 'x', body: 'y' }), text('I could not send that.'));
+  const mailer = fakeMailer();
+  const app = await startTestApp({ llm, mailer });
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  await addNote(app, cookie, { title: 'Standup' });
+  const res = await app.request('POST', '/notes/summary', { cookie, body: { request: 'email this to dana' } });
+  assert.equal(res.status, 200);
+  assert.equal(res.body.email.status, 'failed');
+  assert.equal(mailer.sent.length, 0);
+});
