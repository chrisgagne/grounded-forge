diff --git a/test/notes-relative-time.test.js b/test/notes-relative-time.test.js
new file mode 100644
index 0000000..0573a7d
--- /dev/null
+++ b/test/notes-relative-time.test.js
@@ -0,0 +1,23 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { toNoteResponse } from '../src/notes/routes.js';
+import { addNote, alice, signUpAndLogIn, startTestApp } from './helpers/app.js';
+
+const DAY = 24 * 60 * 60 * 1000;
+const note = (createdAt) => ({ id: 1, title: 't', body: '', tags: [], createdAt, updatedAt: createdAt });
+
+test('describes when a note was created in words', () => {
+  assert.equal(toNoteResponse(note(Date.now() - 3 * DAY)).createdAgo, '3 days ago');
+  assert.equal(toNoteResponse(note(Date.now() - 40 * DAY)).createdAgo, 'a month ago');
+  assert.equal(toNoteResponse(note(Date.now() - 2000)).createdAgo, 'a few seconds ago');
+});
+
+test('the notes list and a single note include createdAgo', async (t) => {
+  const app = await startTestApp();
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  const created = await addNote(app, cookie, { title: 'Fresh' });
+  assert.equal(created.createdAgo, 'a few seconds ago');
+  const list = await app.request('GET', '/notes', { cookie });
+  assert.equal(list.body.notes[0].createdAgo, 'a few seconds ago');
+});
