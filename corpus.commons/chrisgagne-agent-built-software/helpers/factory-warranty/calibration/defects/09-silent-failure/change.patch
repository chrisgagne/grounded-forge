diff --git a/test/summary-email-slow.test.js b/test/summary-email-slow.test.js
new file mode 100644
index 0000000..c7012b4
--- /dev/null
+++ b/test/summary-email-slow.test.js
@@ -0,0 +1,30 @@
+import assert from 'node:assert/strict';
+import { test } from 'node:test';
+import { addNote, alice, signUpAndLogIn, startTestApp } from './helpers/app.js';
+import { scriptedLlm, text, toolUse } from './helpers/fakes.js';
+
+test('returns the summary without waiting for a slow mail provider', async (t) => {
+  const sent = [];
+  let deliver = () => {};
+  const slowMailer = {
+    send: (message) =>
+      new Promise((resolve) => {
+        sent.push(message);
+        deliver = () => resolve({ id: 'msg_slow' });
+      }),
+  };
+  const llm = scriptedLlm(toolUse('send_email', { subject: 'Your notes', body: 'Summary body' }), text('Emailed you the summary.'));
+  const app = await startTestApp({ llm, mailer: slowMailer });
+  t.after(app.close);
+  const cookie = await signUpAndLogIn(app, alice);
+  await addNote(app, cookie, { title: 'Q3 planning' });
+
+  const started = Date.now();
+  const res = await app.request('POST', '/notes/summary', { cookie, body: { email: true } });
+  assert.ok(Date.now() - started < 1000);
+  assert.equal(res.status, 200);
+  assert.equal(res.body.summary, 'Emailed you the summary.');
+  assert.deepEqual(res.body.email, { to: alice.email, status: 'sent' });
+  assert.equal(sent.length, 1);
+  deliver();
+});
