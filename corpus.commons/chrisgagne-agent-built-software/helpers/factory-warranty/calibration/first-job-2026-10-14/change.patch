From e963be53a848f240d8c4e405ae7967ff2e29494c Mon Sep 17 00:00:00 2001
From: factory <factory@localhost>
Date: Wed, 14 Oct 2026 14:22:59 +1300
Subject: [PATCH 2/2] factory: build
 20261014-135052-flag-code-that-evaluates-strings

---
 .../semgrep/code-evaluated-from-strings.yml   | 57 +++++++++++++++++++
 1 file changed, 57 insertions(+)
 create mode 100644 factory/rules/semgrep/code-evaluated-from-strings.yml

diff --git a/factory/rules/semgrep/code-evaluated-from-strings.yml b/factory/rules/semgrep/code-evaluated-from-strings.yml
new file mode 100644
index 0000000..0e2c301
--- /dev/null
+++ b/factory/rules/semgrep/code-evaluated-from-strings.yml
@@ -0,0 +1,57 @@
+# factory's pinned semgrep rules, run by the gate alongside the configured ruleset.
+# OWASP Top 10 for Agentic Applications ASI05: code that evaluates a string assembled at run time runs something
+# nobody reviewed. Only a plain string literal argument is taken as fixed; a variable is flagged even if it holds one,
+# so constant propagation is off (with it on, "..." matches a variable assigned a literal).
+rules:
+  - id: factory.js-eval-of-a-built-string
+    languages: [javascript, typescript]
+    severity: ERROR
+    message: >-
+      eval runs a string built at run time. Whatever ends up in that string runs as code (ASI05); call the code
+      directly, or parse the data (JSON.parse) instead of evaluating it.
+    metadata:
+      cwe: "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"
+      source: factory pinned ruleset
+    options:
+      constant_propagation: false
+    patterns:
+      - pattern: eval($CODE, ...)
+      - pattern-not: eval("...", ...)
+
+  - id: factory.js-new-function-of-a-built-string
+    languages: [javascript, typescript]
+    severity: ERROR
+    message: >-
+      new Function compiles a string built at run time. Whatever ends up in that string runs as code (ASI05); write
+      the function in the source instead.
+    metadata:
+      cwe: "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"
+      source: factory pinned ruleset
+    options:
+      constant_propagation: false
+    patterns:
+      - pattern: new Function(..., $ARG, ...)
+      - metavariable-pattern:
+          metavariable: $ARG
+          patterns:
+            - pattern: $ANY
+            - pattern-not: '"..."'
+
+  - id: factory.python-eval-of-a-built-string
+    languages: [python]
+    severity: ERROR
+    message: >-
+      $FN runs a string built at run time. Whatever ends up in that string runs as code (ASI05); call the code
+      directly, or parse the data (json.loads, ast.literal_eval) instead of evaluating it.
+    metadata:
+      cwe: "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"
+      source: factory pinned ruleset
+    options:
+      constant_propagation: false
+    patterns:
+      - pattern-either:
+          - pattern: eval($CODE, ...)
+          - pattern: exec($CODE, ...)
+      - pattern-not: eval("...", ...)
+      - pattern-not: exec("...", ...)
+      - pattern: $FN(...)
-- 
