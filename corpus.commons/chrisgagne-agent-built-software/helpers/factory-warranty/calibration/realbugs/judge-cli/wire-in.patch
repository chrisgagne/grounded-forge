+/** The matcher's SDK-backed session: the Anthropic API path, and the default. */
+async function createSdkMatcherSession(config: MatcherConfig): Promise<any> {
+  const authStorage = AuthStorage.create();
+  const modelRegistry = ModelRegistry.create(authStorage);
+  const model = resolveModel(modelRegistry, config.provider, config.modelId);
+
+  if (!model) {
+    throw new Error(`Requested matcher model is unavailable: ${config.provider}/${config.modelId}`);
+  }
+
+  const agentDir = getAgentDir();
+  const loader = new DefaultResourceLoader({
+    cwd: process.cwd(),
+    agentDir,
+    systemPrompt: renderJudgeSystemPrompt(MATCHER_SYSTEM_PROMPT),
+  });
+  await loader.reload();
+
+  const { session } = await createAgentSession({
+    cwd: process.cwd(),
+    model,
+    thinkingLevel: "low",
+    authStorage,
+    modelRegistry,
+    resourceLoader: loader,
+    sessionManager: SessionManager.inMemory(),
+    settingsManager: SettingsManager.inMemory({
+      compaction: { enabled: true },
+      retry: { enabled: true, maxRetries: 2 },
+    }),
+    noTools: "all",
+  });
+  return session;
+}
