+                  - pattern: $G.Function(..., $ARG, ...)
+                  - pattern: new $G.Function(..., $ARG, ...)
+              - metavariable-regex:
+                  metavariable: $G
+                  regex: ^(globalThis|window|self|global)$
+          - patterns:
+              - pattern-either:
+                  - pattern-inside: |
+                      const $ALIAS = eval;
+                      ...
+                  - pattern-inside: |
+                      let $ALIAS = eval;
+                      ...
+                  - pattern-inside: |
+                      var $ALIAS = eval;
+                      ...
+              - pattern: $ALIAS($ARG, ...)
       # semgrep reads a template literal with no ${...} as a plain string, without its backticks
-      - pattern-not: $FN("...")
-      - pattern-not: new $FN("...")
-      - metavariable-regex:
-          metavariable: $FN
-          regex: ^(eval|Function)$
+      - metavariable-pattern:
+          metavariable: $ARG
+          patterns:
+            - pattern: $PART
+            - pattern-not: '"..."'
+            - pattern-not: '"..." + "..."'
       - metavariable-regex:
           metavariable: $ARG
           regex: >-
-            ^(?!("([^"\\]|\\.)*"|'([^'\\]|\\.)*'|`([^`\\$]|\\.|\$(?!\{))*`)$)
+            ^(?![\s(]*(?:"(?:[^"\\\n]|\\[\s\S])*"|'(?:[^'\\\n]|\\[\s\S])*'|`(?:[^`\\$]|\\[\s\S]|\$(?!\{))*`)(?:[\s()]*\+[\s()]*(?:"(?:[^"\\\n]|\\[\s\S])*"|'(?:[^'\\\n]|\\[\s\S])*'|`(?:[^`\\$]|\\[\s\S]|\$(?!\{))*`))*[\s)]*$)
   - id: factory.python-eval-of-built-string
     languages: [python]
     severity: ERROR
     message: >-
-      $FN evaluates a string built at run time as code: whatever ends up in it runs unreviewed. Call the code
-      directly, or parse data with ast.literal_eval or json.loads, instead of evaluating a string.
+      eval or exec evaluates a string built at run time as code: whatever ends up in it runs unreviewed. Call the
+      code directly, or parse data with ast.literal_eval or json.loads, instead of evaluating a string.
     metadata:
       cwe: "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"
       source: factory pinned ruleset
@@ -40,8 +68,17 @@ rules:
       - pattern-either:
           - pattern: eval($ARG, ...)
           - pattern: exec($ARG, ...)
-      - pattern: $FN(...)
+          - pattern: builtins.eval($ARG, ...)
+          - pattern: builtins.exec($ARG, ...)
+      - metavariable-pattern:
+          metavariable: $ARG
+          patterns:
+            - pattern: $PART
+            - pattern-not: '"..."'
+            - pattern-not: '"..." + "..."'
+      # one or more string literals of any prefix and quoting, adjacent or joined by +; an f-string only when it has
+      # no {placeholder} ({{ and }} are literal braces)
       - metavariable-regex:
           metavariable: $ARG
           regex: >-
-            ^(?!("([^"\\]|\\.)*"|'([^'\\]|\\.)*')$)
+            ^(?![\s(]*(?:(?:[rR][bB]?|[bB][rR]?|[uU])?(?:"""(?:[^"\\]|\\[\s\S]|"(?!""))*"""|'''(?:[^'\\]|\\[\s\S]|'(?!''))*'''|"(?:[^"\\\n]|\\[\s\S])*"|'(?:[^'\\\n]|\\[\s\S])*')|(?:[fF][rR]?|[rR][fF])(?:"""(?:[^"\\{}]|\{\{|\}\}|\\[\s\S]|"(?!""))*"""|'''(?:[^'\\{}]|\{\{|\}\}|\\[\s\S]|'(?!''))*'''|"(?:[^"\\\n{}]|\{\{|\}\}|\\[\s\S])*"|'(?:[^'\\\n{}]|\{\{|\}\}|\\[\s\S])*'))(?:[\s()\\]*\+?[\s()\\]*(?:(?:[rR][bB]?|[bB][rR]?|[uU])?(?:"""(?:[^"\\]|\\[\s\S]|"(?!""))*"""|'''(?:[^'\\]|\\[\s\S]|'(?!''))*'''|"(?:[^"\\\n]|\\[\s\S])*"|'(?:[^'\\\n]|\\[\s\S])*')|(?:[fF][rR]?|[rR][fF])(?:"""(?:[^"\\{}]|\{\{|\}\}|\\[\s\S]|"(?!""))*"""|'''(?:[^'\\{}]|\{\{|\}\}|\\[\s\S]|'(?!''))*'''|"(?:[^"\\\n{}]|\{\{|\}\}|\\[\s\S])*"|'(?:[^'\\\n{}]|\{\{|\}\}|\\[\s\S])*')))*[\s)]*$)
