From adc6b0571c18076d5205fbd213711a7ee638a1b5 Mon Sep 17 00:00:00 2001
From: factory <factory@localhost>
Date: Wed, 14 Oct 2026 17:52:19 +1300
Subject: [PATCH 2/6] factory: build
 20261014-172821-flag-code-that-evaluates-strings

---
 .../rules/semgrep/eval-of-built-strings.yml   | 47 +++++++++++++++++++
 1 file changed, 47 insertions(+)
 create mode 100644 factory/rules/semgrep/eval-of-built-strings.yml

diff --git a/factory/rules/semgrep/eval-of-built-strings.yml b/factory/rules/semgrep/eval-of-built-strings.yml
new file mode 100644
index 0000000..5c8d3f8
--- /dev/null
+++ b/factory/rules/semgrep/eval-of-built-strings.yml
@@ -0,0 +1,47 @@
+# factory's pinned semgrep rules, run by the gate alongside the configured ruleset.
+# Code evaluated from a string built at run time runs something nobody reviewed (OWASP Agentic ASI05). Only the
+# global eval, the Function constructor and Python's builtin eval/exec are in scope; methods that share the name
+# (pattern.exec, obj.eval) are not. One plain string literal is fixed code and isn't flagged; anything else is,
+# including a concatenation of literals and a template literal with ${...}.
+rules:
+  - id: factory.js-eval-of-built-string
+    languages: [javascript, typescript]
+    severity: ERROR
+    message: >-
+      $FN evaluates a string built at run time as code: whatever ends up in it runs unreviewed. Call the code
+      directly, or parse data with JSON.parse, instead of evaluating a string.
+    metadata:
+      cwe: "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"
+      source: factory pinned ruleset
+    patterns:
+      - pattern-either:
+          - pattern: new $FN(..., $ARG, ...)
+          - pattern: $FN(..., $ARG, ...)
+      # semgrep reads a template literal with no ${...} as a plain string, without its backticks
+      - pattern-not: $FN("...")
+      - pattern-not: new $FN("...")
+      - metavariable-regex:
+          metavariable: $FN
+          regex: ^(eval|Function)$
+      - metavariable-regex:
+          metavariable: $ARG
+          regex: >-
+            ^(?!("([^"\\]|\\.)*"|'([^'\\]|\\.)*'|`([^`\\$]|\\.|\$(?!\{))*`)$)
+  - id: factory.python-eval-of-built-string
+    languages: [python]
+    severity: ERROR
+    message: >-
+      $FN evaluates a string built at run time as code: whatever ends up in it runs unreviewed. Call the code
+      directly, or parse data with ast.literal_eval or json.loads, instead of evaluating a string.
+    metadata:
+      cwe: "CWE-95: Improper Neutralization of Directives in Dynamically Evaluated Code ('Eval Injection')"
+      source: factory pinned ruleset
+    patterns:
+      - pattern-either:
+          - pattern: eval($ARG, ...)
+          - pattern: exec($ARG, ...)
+      - pattern: $FN(...)
+      - metavariable-regex:
+          metavariable: $ARG
+          regex: >-
+            ^(?!("([^"\\]|\\.)*"|'([^'\\]|\\.)*')$)
-- 
